{
  "approvalMode": "auto-review",
  "editor": {
    "vimMode": false
  },
  "hints": true,
  "network": {
    "useHttp1ForAgent": false
  },
  "notifications": true,
  "permissions": {
    "allow": [
      "Shell(cat)",
      "Shell(git diff)",
      "Shell(git status)",
      "Shell(ls)",
      "Shell(pwd)"
    ],
    "deny": [
      "Shell(rm)",
      "Shell(sudo)"
    ]
  },
  "sandbox": {
    "mode": "enabled",
    "networkAccess": "disabled"
  },
  "version": 1
}
