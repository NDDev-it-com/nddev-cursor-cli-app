{
  "schema_version": 3,
  "name": "nddev-cursor-cli-app",
  "build_version": "0.2.0",
  "entrypoint": "python3 cli-tools/nddev_cursor_cli.py",
  "source_roots": {
    "setups": "setups",
    "profiles": "profiles"
  },
  "content_setup_ids": ["nddev-builder"],
  "profile_ids": ["full-auto", "safe"],
  "default_content_setup_id": "nddev-builder",
  "default_profile_id": "full-auto",
  "managed_files": [
    "cli-config.json",
    "NDDEV-CURSOR-CLI-SETUP.json"
  ],
  "command_policy": {
    "json_supported": ["list", "status", "plan", "install", "switch", "migrate", "restore", "remove", "software-status", "install-cli", "update-cli"],
    "plan_mutates": false,
    "restore_backup_option": "--backup <0..9>",
    "target_required": ["status", "plan", "install", "switch", "migrate", "restore", "remove", "software-status", "install-cli", "update-cli", "launch"]
  },
  "backup_policy": {
    "canonical_target_bound": true,
    "envelope": "NDDEV-CURSOR-CLI-BACKUP.json",
    "control_root": ".nddev-cursor-cli",
    "location": ".nddev-cursor-cli/backups",
    "slots": 10
  },
  "legacy_policy": {
    "readable_for": ["status", "migrate", "restore", "remove"],
    "launch_denied": true,
    "install_switch_denied": true
  },
  "runtime_compatibility": {
    "baseline_ref": "references/cursor-cli-baseline.json",
    "version_ref": "build/version.json"
  },
  "runtime_launch": {
    "command": "agent",
    "managed_command": "bin/agent",
    "direct_command": "CURSOR_CONFIG_DIR=<absolute-target> HOME=<absolute-target>/.nddev-cursor-home <absolute-target>/bin/agent --workspace <workspace> [args...]",
    "environment_variable": "CURSOR_CONFIG_DIR",
    "isolated_home": ".nddev-cursor-home",
    "isolated_home_parent_validation": "component real current-user-owned 0700 before subprocess",
    "tmpdir": ".nddev-cursor-runtime/tmp",
    "tmpdir_source": "target-internal real current-user-owned 0700 directory; ambient TMPDIR is not inherited",
    "path_policy": "fixed-minimal-system-path",
    "path_value": "/usr/bin:/bin",
    "launcher_shell": "/bin/bash",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "json_manager_errors_supported": true,
    "manager_command": "python3 cli-tools/nddev_cursor_cli.py launch --target <absolute-target> [--workspace <workspace>] -- [args...]",
    "workspace_source": "default captures the manager caller cwd once; optional manager --workspace selects an existing real directory",
    "native_workspace_arg": "--workspace <path>",
    "child_cwd": "same resolved directory passed to native --workspace",
    "managed_override_args_blocked": ["--approve-mcps", "--force", "-f", "--network", "--sandbox", "--skip-worktree-setup", "--trust", "--workspace", "--worktree", "-w", "--worktree-base", "--yolo", "acp", "install-shell-integration", "sandbox", "uninstall-shell-integration", "update", "worker"],
    "requires_clean_managed_target": true,
    "requires_current_target_owned_software": true,
    "requires_non_legacy_setup_stamp": true,
    "path_fallback": false,
    "streams_child_stdio": true,
    "successful_child_output_wrapped": false,
    "target_environment_scope": "child-process-only",
    "target_lock_scope": "preflight-through-child-and-managed-config-restore",
    "bootstrap_lock_scope": "external product-and-canonical-target flock before target creation or inspection through full operation and child cleanup",
    "bootstrap_lock_exposed_to_child": false,
    "lock_mechanism": "persistent 0600 file opened with O_NOFOLLOW and held by nonblocking fcntl.flock",
    "lock_parent_mode_while_launching": "0500",
    "protected_directory_scope": "dedicated lock parent and ephemeral verified launch image only; control root, backup pool, target root, isolated HOME, TMPDIR, config/session paths, and installed runtime tree remain writable",
    "launch_image": ".nddev-software/cursor-cli/launch-images/<ephemeral>",
    "launch_image_mode_while_launching": "0500",
    "exec_handoff_revalidation": "verified launch-image executable inode and digest immediately before subprocess",
    "exec_handoff_boundary": "write-protected verified-path handoff under no-sandbox same-UID limits; no portable fd execution claimed"
  },
  "software_install": {
    "supported": true,
    "mechanism": "official-cursor-agent-artifact",
    "version": "2026.07.23-e383d2b",
    "command": "agent",
    "status_command": "python3 cli-tools/nddev_cursor_cli.py software-status --target <absolute-target> [--json]",
    "install_command": "python3 cli-tools/nddev_cursor_cli.py install-cli --target <absolute-target> [--json]",
    "update_command": "python3 cli-tools/nddev_cursor_cli.py update-cli --target <absolute-target> [--json]",
    "presence_signal": "software-status JSON exposes present=true and presence entries for NDDEV-CURSOR-CLI-SOFTWARE.json, .nddev-software/cursor-cli, .nddev-software/cursor-cli/versions/2026.07.23-e383d2b, or bin/agent",
    "status_fields": ["installed", "current", "present", "presence", "drift"],
    "install_precondition": "absent target-owned software presence",
    "update_precondition": "existing target-owned software presence, including repairable missing or corrupt identity stamp",
    "update_current_behavior": "idempotent no-op without downloading",
    "stage_and_atomic_swap": true,
    "managed_command": "bin/agent",
    "layout": ".nddev-software/cursor-cli/versions/2026.07.23-e383d2b/ full dist-package runtime tree plus bin/agent launcher",
    "npm": null,
    "pip": null
  },
  "builder_projection": {
    "status": "native-local-plugin-projection",
    "default_on": true,
    "plugin_manifest": "plugins/nddev-builder/.cursor-plugin/plugin.json",
    "target_plugin_path": ".nddev-cursor-home/.cursor/plugins/local/nddev-builder",
    "surfaces": ["plugin", "rules", "skills", "agents", "commands"],
    "hooks_installed": false,
    "mcp_servers_installed": false,
    "official_documentation": {
      "plugins": "https://cursor.com/docs/plugins",
      "plugins_reference": "https://cursor.com/docs/reference/plugins",
      "rules": "https://cursor.com/docs/rules",
      "skills": "https://cursor.com/docs/skills",
      "agents": "https://cursor.com/docs/subagents",
      "hooks": "https://cursor.com/docs/hooks",
      "mcp": "https://cursor.com/docs/mcp"
    },
    "marketplace": {
      "team_marketplace_supported_by_cursor": true,
      "module_installs_marketplace": false,
      "reason": "The setup manager projects a local native Cursor plugin into the launch-isolated target home; it does not provision Cursor team marketplace state."
    }
  },
  "transaction_policy": {
    "managed_file_mode": "0600",
    "new_target_mode": "0700",
    "initial_target_parent": "current-user non-writable-by-others or sticky",
    "existing_target_required_owner": "current-user",
    "existing_target_required_mode": "0700",
    "preserve_unmanaged_files": true,
    "preserve_unmanaged_config_keys": true,
    "reject_symlink_managed_files": true,
    "target_local_directory_parents": "existing builder and runtime parents must be real current-user-owned 0700; symlinks are drift/fail-closed",
    "rollback_on_failure": true,
    "staging": "same-parent temporary directory",
    "control_root": ".nddev-cursor-cli",
    "lock_parent": ".nddev-cursor-cli/locks",
    "lock": ".nddev-cursor-cli/locks/target.lock",
    "lock_type": "persistent flock file",
    "lock_file_mode": "0600",
    "lock_parent_mode_while_locked": "0500",
    "bootstrap_product_lock": "/tmp-or-resolved-system-temp/nddev-cursor-cli-app-locks-<uid>/global.lock",
    "bootstrap_lock": "/tmp-or-resolved-system-temp/nddev-cursor-cli-app-locks-<uid>/nddev-cursor-cli-app-<sha256(product-name NUL canonical-target)>.lock",
    "bootstrap_lock_file_mode": "0600",
    "bootstrap_lock_binding": "schema/product/canonical-target/product-target-sha256 JSON",
    "mutable_runtime_tmp": ".nddev-cursor-runtime/tmp"
  }
}
