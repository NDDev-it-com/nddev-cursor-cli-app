{
  "backup_policy": {
    "canonical_target_bound": true,
    "control_root": ".nddev-cursor-cli",
    "digest_authenticates_same_uid_payloads": false,
    "digest_capability": "corruption-and-incoherent-tamper-detection",
    "envelope": "NDDEV-CURSOR-CLI-BACKUP.json",
    "envelope_schema": 3,
    "file_record_schema": "payload plus sha256 over canonical declared path and payload bytes",
    "location": ".nddev-cursor-cli/backups",
    "restore_digest_required": true,
    "slots": 10
  },
  "build_version": "0.2.1",
  "builder_projection": {
    "default_on": true,
    "hooks_installed": false,
    "marketplace": {
      "module_installs_marketplace": false,
      "reason": "The setup manager projects a local native Cursor plugin into the launch-isolated target home; it does not provision Cursor team marketplace state.",
      "team_marketplace_supported_by_cursor": true
    },
    "mcp_servers_installed": false,
    "official_documentation": {
      "agents": "https://cursor.com/docs/subagents",
      "hooks": "https://cursor.com/docs/hooks",
      "mcp": "https://cursor.com/docs/mcp",
      "plugins": "https://cursor.com/docs/plugins",
      "plugins_reference": "https://cursor.com/docs/reference/plugins",
      "rules": "https://cursor.com/docs/rules",
      "skills": "https://cursor.com/docs/skills"
    },
    "plugin_manifest": "plugins/nddev-builder/.cursor-plugin/plugin.json",
    "status": "native-local-plugin-projection",
    "surfaces": [
      "plugin",
      "rules",
      "skills",
      "agents",
      "commands"
    ],
    "target_plugin_path": ".nddev-cursor-home/.cursor/plugins/local/nddev-builder"
  },
  "command_policy": {
    "json_supported": [
      "list",
      "status",
      "plan",
      "install",
      "update",
      "switch",
      "migrate",
      "restore",
      "remove",
      "software-status",
      "install-cli",
      "update-cli",
      "remove-cli"
    ],
    "plan_mutates": false,
    "restore_backup_option": "--backup <0..9>",
    "target_required": [
      "status",
      "plan",
      "install",
      "update",
      "switch",
      "migrate",
      "restore",
      "remove",
      "software-status",
      "install-cli",
      "update-cli",
      "remove-cli",
      "launch"
    ]
  },
  "content_setup_ids": [
    "nddev-builder"
  ],
  "default_content_setup_id": "nddev-builder",
  "default_profile_id": "full-auto",
  "entrypoint": "python3 cli-tools/nddev_cursor_cli.py",
  "legacy_policy": {
    "install_switch_denied": true,
    "launch_denied": true,
    "readable_for": [
      "status",
      "migrate",
      "restore",
      "remove"
    ]
  },
  "managed_files": [
    "cli-config.json",
    "NDDEV-CURSOR-CLI-SETUP.json"
  ],
  "name": "nddev-cursor-cli-app",
  "profile_ids": [
    "full-auto",
    "safe"
  ],
  "runtime_compatibility": {
    "baseline_ref": "references/cursor-cli-baseline.json",
    "supported_host_ids": [
      "macos-arm64",
      "macos-x64",
      "ubuntu-glibc-arm64",
      "ubuntu-glibc-x64"
    ],
    "ubuntu_distribution_id": "ubuntu",
    "ubuntu_glibc_version_floor": null,
    "ubuntu_glibc_version_floor_status": "no-official-floor",
    "ubuntu_libc": "glibc",
    "ubuntu_systems": [
      "desktop",
      "server"
    ],
    "unsupported_host_categories": [
      "windows",
      "non-ubuntu-linux",
      "linux-musl",
      "unsupported-architecture"
    ],
    "vendor_asset_mapping": {
      "macos-arm64": {
        "asset_path": "darwin/arm64/agent-cli-package.tar.gz",
        "vendor_arch": "arm64",
        "vendor_os": "darwin"
      },
      "macos-x64": {
        "asset_path": "darwin/x64/agent-cli-package.tar.gz",
        "vendor_arch": "x64",
        "vendor_os": "darwin"
      },
      "ubuntu-glibc-arm64": {
        "asset_path": "linux/arm64/agent-cli-package.tar.gz",
        "vendor_arch": "arm64",
        "vendor_os": "linux"
      },
      "ubuntu-glibc-x64": {
        "asset_path": "linux/x64/agent-cli-package.tar.gz",
        "vendor_arch": "x64",
        "vendor_os": "linux"
      }
    },
    "version_ref": "build/version.json"
  },
  "runtime_launch": {
    "bootstrap_lock_exposed_to_child": false,
    "bootstrap_lock_scope": "mutations publish or open the product anchor before target observation, then hand off to the canonical mutation anchor; read-only commands create no anchors and use cold no-anchor double-check with whole product-namespace emptiness or shared product/canonical coordination",
    "command": "agent",
    "direct_command": "CURSOR_CONFIG_DIR=<absolute-target> HOME=<absolute-target>/.nddev-cursor-home <absolute-target>/bin/agent [args...]",
    "environment_variable": "CURSOR_CONFIG_DIR",
    "exec_handoff_boundary": "write-protected verified-path handoff with child-held launch-image lease fd under no-sandbox same-UID limits; no portable fd execution claimed",
    "exec_handoff_revalidation": "verified launch-image executable inode and digest immediately before subprocess",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "isolated_home": ".nddev-cursor-home",
    "isolated_home_parent_validation": "component real current-user-owned 0700 before subprocess",
    "json_manager_errors_supported": true,
    "launch_image": ".nddev-software/cursor-cli/launch-images/.launch-<bounded>",
    "launch_image_lease": ".nddev-software/cursor-cli/launch-images/.launch-<bounded>/.lease.lock",
    "launch_image_max_count": 8,
    "launch_image_max_total_size": 314572800,
    "launch_image_metadata": ".nddev-software/cursor-cli/launch-images/.launch-<bounded>/NDDEV-CURSOR-CLI-LAUNCH.json",
    "launch_image_mode_while_launching": "0500",
    "launch_image_residue_semantics": "read-only status validates and exposes active/stale lease-bound images without mutation; mutations drain stale images with bounded no-follow cleanup before active work and fail closed while a lease is active",
    "launcher_shell": "/bin/bash",
    "lock_mechanism": "persistent 0600 monotonic anchors opened with O_NOFOLLOW and held by nonblocking fcntl.flock; product anchor uses exclusive/shared coordination and canonical target anchors use exclusive mutation/shared read coordination",
    "lock_parent_mode_while_launching": "0500",
    "managed_command": "bin/agent",
    "managed_override_args_blocked": [
      "--approve-mcps",
      "--force",
      "-f",
      "--network",
      "--sandbox",
      "--skip-worktree-setup",
      "--trust",
      "--worktree",
      "-w",
      "--yolo",
      "acp",
      "install-shell-integration",
      "sandbox",
      "uninstall-shell-integration",
      "update",
      "worker"
    ],
    "manager_command": "python3 cli-tools/nddev_cursor_cli.py launch --target <absolute-target> -- [args...]",
    "target_role": "managed-configuration-runtime-home",
    "workspace_source": "captured-caller-current-directory",
    "child_working_directory_policy": "strict-resolved-caller-workspace",
    "native_workspace_argument": null,
    "path_fallback": false,
    "path_policy": "fixed-minimal-system-path",
    "path_value": "/usr/bin:/bin",
    "protected_directory_scope": "dedicated lock parent and lease-bound verified launch image only; control root, backup pool, target root, isolated HOME, TMPDIR, config/session paths, and installed runtime tree remain writable",
    "requires_clean_managed_target": true,
    "requires_current_target_owned_software": true,
    "requires_non_legacy_setup_stamp": true,
    "streams_child_stdio": true,
    "successful_child_output_wrapped": false,
    "target_environment_scope": "child-process-only",
    "target_lock_scope": "preflight-through-child-and-managed-config-restore",
    "tmpdir": ".nddev-cursor-runtime/tmp",
    "tmpdir_source": "target-internal real current-user-owned 0700 directory; ambient TMPDIR is not inherited"
  },
  "schema_version": 3,
  "software_install": {
    "command": "agent",
    "host_platform_preflight": "Supported NDDev host IDs are macos-arm64, macos-x64, ubuntu-glibc-arm64, and ubuntu-glibc-x64. Ubuntu desktop/server hosts must report ID=ubuntu and glibc; Cursor publishes no official Ubuntu/glibc version floor. Upstream darwin/* and linux/* artifact paths remain vendor IDs. windows, non-ubuntu-linux, linux-musl, and unsupported-architecture fail before bootstrap lock, target lock, target creation, download, stage, or launch",
    "install_command": "python3 cli-tools/nddev_cursor_cli.py install-cli --target <absolute-target> [--json]",
    "install_precondition": "absent target-owned software presence",
    "layout": ".nddev-software/cursor-cli/versions/2026.07.23-e383d2b/ full dist-package runtime tree plus bin/agent launcher",
    "managed_command": "bin/agent",
    "mechanism": "official-cursor-agent-artifact",
    "npm": null,
    "pip": null,
    "presence_signal": "software-status JSON exposes present=true and presence entries for NDDEV-CURSOR-CLI-SOFTWARE.json, .nddev-software/cursor-cli, .nddev-software/cursor-cli/launch-images, .nddev-software/cursor-cli/versions/2026.07.23-e383d2b, or bin/agent",
    "remove_command": "python3 cli-tools/nddev_cursor_cli.py remove-cli --target <absolute-target> [--json]",
    "remove_precondition": "absent, current, or partial target-owned software presence",
    "stage_and_atomic_swap": true,
    "status_command": "python3 cli-tools/nddev_cursor_cli.py software-status --target <absolute-target> [--json]",
    "status_fields": [
      "installed",
      "current",
      "present",
      "presence",
      "drift",
      "cleanup_pending",
      "cleanup",
      "launch_image_residue_pending",
      "launch_image_residue"
    ],
    "supported": true,
    "update_command": "python3 cli-tools/nddev_cursor_cli.py update-cli --target <absolute-target> [--json]",
    "update_current_behavior": "idempotent no-op without downloading",
    "update_precondition": "existing target-owned software presence, including repairable missing or corrupt identity stamp",
    "version": "2026.07.23-e383d2b"
  },
  "source_roots": {
    "profiles": "profiles",
    "setups": "setups"
  },
  "transaction_policy": {
    "bootstrap_anchor_publication": "atomic no-replace final-path publication of a complete fsynced binding; final anchor is monotonic immediately when visible, parent sync or handoff failure leaves it in place and removes only unpublished temporary aliases; existing anchors open no-create/no-follow and are never truncated, rebound, replaced, or unlinked; a crashed hard-link publication alias is recovered only after locking final and proving one bounded machine-named same-inode alias in the same private parent",
    "bootstrap_canonical_mutation_anchor": "/tmp-or-resolved-system-temp/nddev-cursor-cli-app-locks-<uid>/nddev-cursor-cli-app-<sha256(product-name NUL canonical-target-key)>.lock",
    "bootstrap_lock_binding": "schema/product/lock-key/product-target-sha256 JSON",
    "bootstrap_lock_file_mode": "0600",
    "bootstrap_product_anchor": "/tmp-or-resolved-system-temp/nddev-cursor-cli-app-locks-<uid>/global.lock",
    "cleanup_journal_max_bytes": 2097152,
    "cleanup_pending_intent": ".nddev-cursor-cli/cleanup-pending/intent.json",
    "cleanup_pending_journal": ".nddev-cursor-cli/cleanup-pending/journal.json",
    "cleanup_pending_path": ".nddev-cursor-cli/cleanup-pending",
    "cleanup_pending_semantics": "schema-1 cleanup journal plus durable pre-move intent with fixed-anchor relative sources; read-only validates and reports cleanup_pending without mutation; mutations drain before active changes; malformed or orphaned cleanup state fails closed",
    "control_root": ".nddev-cursor-cli",
    "existing_target_required_mode": "0700",
    "existing_target_required_owner": "current-user",
    "initial_target_parent": "current-user non-writable-by-others or sticky",
    "lock": ".nddev-cursor-cli/locks/target.lock",
    "lock_file_mode": "0600",
    "lock_parent": ".nddev-cursor-cli/locks",
    "lock_parent_mode_while_locked": "0500",
    "lock_type": "persistent flock file",
    "managed_file_mode": "0600",
    "managed_transaction_journal": ".nddev-cursor-cli/.managed-txn-<unique>",
    "managed_transaction_residue_on_failure": false,
    "mutable_runtime_tmp": ".nddev-cursor-runtime/tmp",
    "new_target_mode": "0700",
    "preserve_unmanaged_config_keys": true,
    "preserve_unmanaged_files": true,
    "read_only_anchor_commands": [
      "status",
      "plan",
      "software-status"
    ],
    "read_only_anchor_creation": false,
    "read_only_cold_no_anchor_double_check": true,
    "read_only_orphan_canonical_anchor": "fail-closed",
    "reject_symlink_managed_files": true,
    "rollback_on_failure": true,
    "staging": "same-parent temporary directory",
    "target_local_directory_parents": "existing builder and runtime parents must be real current-user-owned 0700; symlinks are drift/fail-closed"
  }
}
