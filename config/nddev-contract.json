{
  "contract_version": 3,
  "product_name": "nddev-cursor-cli-app",
  "display_name": "NDDev Cursor CLI Setup Manager",
  "description": "Portable, target-explicit manager for Cursor CLI configuration, target-owned Cursor Agent software, and a default-on native nddev-builder Cursor plugin projection.",
  "github_repository": "NDDev-it-com/nddev-cursor-cli-app",
  "license": "AGPL-3.0-or-later",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "source_roots": {
    "setups": "setups",
    "profiles": "profiles"
  },
  "managed_state": {
    "managed_files": ["cli-config.json"],
    "managed_file_mode": "0600",
    "preserve_other_state": true,
    "preserve_unmanaged_config_keys": true,
    "stamp_file": "NDDEV-CURSOR-CLI-SETUP.json",
    "stamp_schema": 2
  },
  "setup_system": {
    "catalog_root": "setups",
    "profile_root": "profiles",
    "content_setup_ids": ["nddev-builder"],
    "profile_ids": ["full-auto", "safe"],
    "default_content_setup_id": "nddev-builder",
    "default_profile_id": "full-auto",
    "identity_source": "setups/<id>/setup.json:id and profiles/<id>/profile.json:id",
    "list_command": "python3 cli-tools/nddev_cursor_cli.py list [--json]",
    "selection_options": ["--setup <id>", "--profile <id>"],
    "status_command": "python3 cli-tools/nddev_cursor_cli.py status --target <absolute-dir> [--json]",
    "migrate_command": "python3 cli-tools/nddev_cursor_cli.py migrate --target <absolute-dir> [--profile <id>] [--json]"
  },
  "legacy_policy": {
    "readable_for": ["status", "migrate", "restore", "remove"],
    "launch_denied": true,
    "install_switch_denied": true
  },
  "runtime_compatibility": {
    "baseline_ref": "references/cursor-cli-baseline.json",
    "version_ref": "build/version.json"
  },
  "runtime_launch": {
    "command": "agent",
    "managed_command": "bin/agent",
    "direct_command": "CURSOR_CONFIG_DIR=<absolute-target> HOME=<absolute-target>/.nddev-cursor-home <absolute-target>/bin/agent [args...]",
    "environment_variable": "CURSOR_CONFIG_DIR",
    "isolated_home": ".nddev-cursor-home",
    "path_policy": "fixed-minimal-system-path",
    "path_value": "/usr/bin:/bin",
    "launcher_shell": "/bin/bash",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "json_manager_errors_supported": true,
    "manager_command": "python3 cli-tools/nddev_cursor_cli.py launch --target <absolute-target> -- [args...]",
    "managed_override_args_blocked": ["--approve-mcps", "--force", "-f", "--network", "--sandbox", "--skip-worktree-setup", "--trust", "--worktree", "-w", "--yolo", "acp", "install-shell-integration", "sandbox", "uninstall-shell-integration", "update", "worker"],
    "requires_clean_managed_target": true,
    "requires_current_target_owned_software": true,
    "requires_non_legacy_setup_stamp": true,
    "path_fallback": false,
    "streams_child_stdio": true,
    "successful_child_output_wrapped": false,
    "target_environment_scope": "child-process-only"
  },
  "software_install": {
    "supported": true,
    "mechanism": "official-cursor-agent-artifact",
    "official_installer": "https://cursor.com/install",
    "official_source": "https://downloads.cursor.com/lab/2026.07.23-e383d2b/{os}/{arch}/agent-cli-package.tar.gz",
    "command": "agent",
    "version": "2026.07.23-e383d2b",
    "managed_command": "bin/agent",
    "status_command": "python3 cli-tools/nddev_cursor_cli.py software-status --target <absolute-target> [--json]",
    "install_command": "python3 cli-tools/nddev_cursor_cli.py install-cli --target <absolute-target> [--json]",
    "update_command": "python3 cli-tools/nddev_cursor_cli.py update-cli --target <absolute-target> [--json]",
    "presence_signal": "software-status JSON exposes present=true and presence entries for NDDEV-CURSOR-CLI-SOFTWARE.json, .nddev-software/cursor-cli, .nddev-software/cursor-cli/versions/2026.07.23-e383d2b, or bin/agent",
    "status_fields": ["installed", "current", "present", "presence", "drift"],
    "install_precondition": "absent target-owned software presence",
    "update_precondition": "existing target-owned software presence, including repairable missing or corrupt identity stamp",
    "update_current_behavior": "idempotent no-op without downloading",
    "stage_and_atomic_swap": true,
    "rollback_on_failure": true,
    "artifact_reader": "bounded dist-package runtime-tree extraction; requires cursor-agent, node, and index.js; rejects traversal, symlink, hardlink, device, duplicate, unsafe mode, and oversize members",
    "npm": null,
    "pip": null
  },
  "software_lifecycle": {
    "stamp_file": "NDDEV-CURSOR-CLI-SOFTWARE.json",
    "stamp_schema": 1,
    "status_command": "python3 cli-tools/nddev_cursor_cli.py software-status --target /absolute/target --json",
    "install_command": "python3 cli-tools/nddev_cursor_cli.py install-cli --target /absolute/target --json",
    "update_command": "python3 cli-tools/nddev_cursor_cli.py update-cli --target /absolute/target --json",
    "presence_signal": "software-status JSON exposes present=true and presence entries for NDDEV-CURSOR-CLI-SOFTWARE.json, .nddev-software/cursor-cli, .nddev-software/cursor-cli/versions/2026.07.23-e383d2b, or bin/agent",
    "install_precondition": "install-cli refuses any existing target-owned software presence; use update-cli for partial or existing state",
    "update_precondition": "update-cli repairs existing target-owned software presence and refuses absent software state",
    "target_owned": true,
    "software_root": ".nddev-software/cursor-cli/versions/2026.07.23-e383d2b",
    "entrypoint": "bin/agent",
    "status_executes_binary": false,
    "private_modes": {
      "directories": "0700",
      "stamp": "0600",
      "binary": "0700"
    },
    "stage_and_atomic_swap": true,
    "rollback_on_swap_failure": true,
    "credential_inheritance": "provider secrets are not inherited by installer subprocesses or launch"
  },
  "builder_projection": {
    "default_on": true,
    "installation": {
      "cache_owner": "nddev-cursor-cli-app",
      "install_command": "python3 cli-tools/nddev_cursor_cli.py install --target <absolute-target> [--profile <id>] [--json]",
      "native_local_plugin_path": ".nddev-cursor-home/.cursor/plugins/local/nddev-builder",
      "orthogonal_to_setup_switching": true,
      "plugin_manifest": "plugins/nddev-builder/.cursor-plugin/plugin.json",
      "preserved_on_switch_restore": true,
      "status_command": "python3 cli-tools/nddev_cursor_cli.py status --target <absolute-target> [--json]"
    },
    "official_documentation": {
      "agents": "https://cursor.com/docs/subagents",
      "hooks": "https://cursor.com/docs/hooks",
      "mcp": "https://cursor.com/docs/mcp",
      "plugins": "https://cursor.com/docs/plugins",
      "plugins_reference": "https://cursor.com/docs/reference/plugins",
      "rules": "https://cursor.com/docs/rules",
      "skills": "https://cursor.com/docs/skills"
    },
    "marketplace": {
      "module_installs_marketplace": false,
      "status": "unsupported-by-this-manager",
      "team_marketplace_supported_by_cursor": true
    },
    "surfaces": ["plugin", "rules", "skills", "agents", "commands"],
    "hooks_installed": false,
    "mcp_servers_installed": false
  },
  "safety": {
    "absolute_target_required": true,
    "canonical_target_binding": true,
    "default_target": null,
    "explicit_target_required": ["status", "plan", "install", "switch", "migrate", "restore", "remove", "software-status", "install-cli", "update-cli", "launch"],
    "max_backups": 10,
    "missing_target_argument_rejected": true,
    "new_target_mode": "0700",
    "preserve_existing_target_mode": true,
    "relative_target_rejected": true,
    "rollback_on_failure": true,
    "target_symlinks_rejected": true
  }
}
